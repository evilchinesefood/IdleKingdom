# Copy to repo-root .npmrc (gitignored) and fill the token from the macOS Keychain (service jdayers-hub, account fontawesome.npm-token): security find-generic-password -s jdayers-hub -a fontawesome.npm-token -w
@fortawesome:registry=https://npm.fontawesome.com/
@awesome.me:registry=https://npm.fontawesome.com/
//npm.fontawesome.com/:_authToken=YOUR_FA_PACKAGE_TOKEN
